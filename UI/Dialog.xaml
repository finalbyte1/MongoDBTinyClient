<Window x:Class="MongoDBTinyClient.UI.Dialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="440" SizeToContent="Height" ResizeMode="NoResize"
        Background="{StaticResource BackgroundBrush}" Foreground="{StaticResource TextBrush}"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Ideal" FontFamily="{StaticResource UiFont}" FontSize="12.5">
    <StackPanel Margin="18,16,18,16">
        <TextBlock x:Name="MessageText" Style="{StaticResource BodyText}" TextWrapping="Wrap" LineHeight="19" />
        <StackPanel x:Name="FieldsPanel" Margin="0,4,0,0" />
        <TextBlock x:Name="ErrorText" Style="{StaticResource CaptionText}" Foreground="{StaticResource DangerBrush}"
                   TextWrapping="Wrap" Margin="0,8,0,0" Visibility="Collapsed" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button x:Name="CancelButton" Style="{StaticResource FlatButton}" Content="Cancel" MinWidth="80" IsCancel="True" />
            <Button x:Name="OkButton" Style="{StaticResource AccentButton}" Content="OK" MinWidth="80" Margin="8,0,0,0" IsDefault="True" />
        </StackPanel>
    </StackPanel>
</Window>
